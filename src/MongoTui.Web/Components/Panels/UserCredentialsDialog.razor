@inject IJSRuntime JS
@inject WebText L
<Modal Title="@L[PasswordChanged ? LocalizationKeys.Users.PasswordChangedTitle : LocalizationKeys.Users.CreatedTitle]" Class="wide-modal user-credentials" OnClose="OnClose">
    <div class="modal-body">
        <p class="field-hint users-notice">@L[LocalizationKeys.Users.CreatedPasswordShownOnce]</p>
        <label for="created-user-name">@L[LocalizationKeys.Users.FieldUsername]</label><input id="created-user-name" readonly value="@Credentials.Username" autocomplete="off" />
        <label for="created-user-password">@L[LocalizationKeys.Users.FieldPassword]</label>
        <div class="user-password-field"><input id="created-user-password" readonly value="@Credentials.Password" autocomplete="off" class="mono" /><button class="button secondary compact" @onclick="() => CopyAsync(true)"><Icon Name="@IconNames.Copy" Size="15" />@L[LocalizationKeys.Users.CredentialsCopyPassword]</button></div>
        <label for="created-user-uri">@L[LocalizationKeys.Users.CredentialsConnectionString]</label><textarea id="created-user-uri" readonly rows="4" class="mono" autocomplete="off">@Credentials.ConnectionString</textarea>
        <button class="button secondary compact" @onclick="() => CopyAsync(false)"><Icon Name="@IconNames.Copy" Size="15" />@L[LocalizationKeys.Users.CreatedCopyConnectionString]</button>
        @if (Credentials.SshEnabled) { <p class="field-hint users-notice">@L[LocalizationKeys.Users.CreatedSshWarning]</p> }
        @if (ReconnectRequired) { <p class="field-hint users-notice" role="status">@L[LocalizationKeys.Users.PasswordChangedCurrent]</p> }
        <FormFeedback Error="@(_copyFailed ? _status : null)" Success="@(!_copyFailed ? _status : null)" />
        <footer class="modal-actions"><button class="button primary" @onclick="OnClose">@L[LocalizationKeys.Common.Close]</button></footer>
    </div>
</Modal>
@code {
    [Parameter, EditorRequired] public UserCredentials Credentials { get; set; } = null!;
    [Parameter] public bool PasswordChanged { get; set; }
    [Parameter] public bool ReconnectRequired { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string? _status;
    private bool _copyFailed;
    private async Task CopyAsync(bool password)
    {
        try
        {
            await JS.InvokeVoidAsync(JavaScriptCalls.CopyText, password ? Credentials.Password : Credentials.ConnectionString);
            _copyFailed = false;
            _status = L[password ? LocalizationKeys.Users.CredentialsPasswordCopied : LocalizationKeys.Users.CreatedCopied];
        }
        catch (JSException)
        {
            _copyFailed = true;
            _status = L[password ? LocalizationKeys.Users.CredentialsPasswordCopyFailed : LocalizationKeys.Users.CreatedCopyFailed];
        }
    }
}
