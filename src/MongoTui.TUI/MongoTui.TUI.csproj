<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MongoTui.TUI</RootNamespace>
    <AssemblyName>mongo-tui</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MongoTui.Application\MongoTui.Application.csproj" />
    <ProjectReference Include="..\MongoTui.Infrastructure\MongoTui.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MongoTui.TUI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE;..\..\THIRD-PARTY-LICENSES.md"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
